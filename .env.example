# Copy this file to .env for local development. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=True
ALLOW_ADMIN_SIGNUP=true

# MySQL (local MySQL or your Aiven service)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=shopsphere
# DB_SSL_DISABLED=true     # only for a local MySQL without TLS

# Razorpay (use TEST keys: rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Images: leave empty locally (files go to static/images). Set on Render:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email: production uses Brevo's HTTPS API
# BREVO_API_KEY=xkeysib-xxxxxxxx
# MAIL_SENDER=the-address-you-verified-in-Brevo@example.com
# Local-only fallback (Gmail App Password; does not work on Render free):
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
